<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Diarmuid Moloney</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f7f7f5;
      color: #202020;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                   Roboto, Helvetica, Arial, sans-serif;
    }

    main {
      width: 90%;
      max-width: 700px;
      text-align: center;
      padding: 40px 20px;
    }

    h1 {
      margin: 0 0 16px;
      font-size: clamp(2.7rem, 9vw, 5rem);
      font-weight: 600;
      letter-spacing: -0.05em;
    }

    .interests {
      margin: 0 0 24px;
      font-size: 1.15rem;
      color: #666;
      letter-spacing: 0.04em;
    }

    .location {
      margin-bottom: 35px;
      color: #888;
    }

    .links a {
      display: inline-block;
      margin: 8px 12px;
      color: #202020;
      text-decoration: none;
      border-bottom: 1px solid #aaa;
      padding-bottom: 3px;
    }

    .links a:hover {
      border-color: #202020;
    }
  </style>
</head>

<body>

  <main>

    <h1>Diarmuid Moloney</h1>

    <p class="interests">
      Finance · Agriculture · Technology
    </p>

    <p class="location">
      Waterford, Ireland
    </p>

    <div class="links">
      <a href="mailto:mail@diarmuidmoloney.ie">Email</a>
    </div>

  </main>

</body>
</html>
